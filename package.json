{
  "name": "edu-vision-ai-monitor",
  "version": "0.1.0",
  "private": true,
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "node backend/api/index.js",
    "start:frontend": "cd frontend && npm start",
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "build": "cd frontend && npm run build",
    "test": "cd frontend && npm test",
    "install:all": "npm install && cd frontend && npm install && cd ../backend && npm install && cd api && npm install"
  },
  "description": "EduVision - AI-powered exam proctoring system",
  "dependencies": {
    "antd": "^4.24.16"
  }
}
